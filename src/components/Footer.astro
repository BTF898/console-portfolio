---
import { SITE } from '../config/site';
import { ACHIEVEMENTS } from '../config/achievements';

const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="container">
    {
      SITE.features.achievements && (
        <div class="footer-ach" title="Little rewards for exploring — keep scrolling, typing and clicking.">
          <span class="ach-label mono">achievements</span>
          <span class="ach-cells" aria-hidden="true">
            {ACHIEVEMENTS.map((a) => (
              <i class="ach-cell" data-ach={a.id} title={`${a.label} — ${a.hint}`} />
            ))}
          </span>
          <span class="ach-count mono" data-ach-count>
            0/{ACHIEVEMENTS.length}
          </span>
        </div>
      )
    }
    <div class="footer-inner">
    <div class="footer-note">
      © {year} {SITE.name} · Built with
      <a href="https://astro.build" target="_blank" rel="noopener">Astro</a>
    </div>
    <div class="footer-right">
      {
        SITE.socials.map((s) => (
          <a href={s.url} target="_blank" rel="noopener" class="mono dim">
            {s.label}
          </a>
        ))
      }
      <button class="icon-btn" type="button" data-theme-toggle aria-label="Toggle color mode">
        <svg width="15" height="15" viewBox="0 0 16 16" fill="none" aria-hidden="true">
          <path
            d="M8 1v2M8 13v2M15 8h-2M3 8H1M12.9 3.1l-1.4 1.4M4.5 11.5l-1.4 1.4M12.9 12.9l-1.4-1.4M4.5 4.5L3.1 3.1"
            stroke="currentColor"
            stroke-width="1.4"
            stroke-linecap="round"></path>
          <circle cx="8" cy="8" r="3.2" stroke="currentColor" stroke-width="1.4"></circle>
        </svg>
      </button>
      <a class="icon-btn" href="#top" aria-label="Back to top">
        <svg width="15" height="15" viewBox="0 0 16 16" fill="none" aria-hidden="true">
          <path d="M8 13V3M3.5 7.5 8 3l4.5 4.5" stroke="currentColor" stroke-width="1.4" stroke-linecap="round"
            stroke-linejoin="round"></path>
        </svg>
      </a>
    </div>
    </div>
  </div>
</footer>

{SITE.features.achievements && <script>import '../scripts/achievements';</script>}
