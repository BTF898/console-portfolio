---
import Base from '../layouts/Base.astro';
import { SITE } from '../config/site';
import { getExperience, getProjects } from '../lib/cv';
import { formatRange } from '@portfolio/cv-contract';

const projects = await getProjects();
const experience = await getExperience();

const year = new Date().getFullYear();
---

<Base>
  <main>
    <section class="hero">
      <div class="wrap">
        <h1 class="hero-name">Sam <em>Rivera</em></h1>
        <p class="hero-role">
          <span class="kicker">{SITE.role}</span>
          <span class="kicker">·</span>
          <span class="kicker">{SITE.location}</span>
        </p>
        <p class="hero-tagline">{SITE.tagline}</p>
        <p class="hero-meta">
          <span class="kicker"><span class="dot"></span>{SITE.availability}</span>
        </p>
      </div>
    </section>

    <section class="section" id="work">
      <div class="wrap">
        <div class="section-head">
          <span class="num kicker">01</span>
          <h2>Selected work</h2>
          <span class="rule" aria-hidden="true"></span>
        </div>
        <ol class="index-list">
          {
            projects.map((project, i) => {
              const link = project.data.links.live ?? project.data.links.repo;
              return (
                <li class="index-row">
                  <span class="num" aria-hidden="true">
                    {String(i + 1).padStart(2, '0')}
                  </span>
                  <div>
                    <h3>{project.data.title}</h3>
                    <span class="tagline">{project.data.tagline}</span>
                  </div>
                  <p class="summary">{project.data.summary}</p>
                  <div class="side">
                    <span class="year">{project.data.year}</span>
                    {link && (
                      <a href={link} target="_blank" rel="noopener noreferrer">
                        {project.data.links.live ? 'Visit ↗' : 'Code ↗'}
                      </a>
                    )}
                  </div>
                  {project.data.metrics.length > 0 && (
                    <div class="metrics">
                      {project.data.metrics.map((m) => (
                        <span class="metric">
                          <span class="value">{m.value}</span>
                          <span class="label">{m.label}</span>
                        </span>
                      ))}
                    </div>
                  )}
                </li>
              );
            })
          }
        </ol>
      </div>
    </section>

    <section class="section" id="experience">
      <div class="wrap">
        <div class="section-head">
          <span class="num kicker">02</span>
          <h2>Experience</h2>
          <span class="rule" aria-hidden="true"></span>
        </div>
        <p class="section-lede">
          What I did at each stop — with the numbers that prove it.
        </p>
        {
          experience.map((entry) => (
            <article class="xp-entry">
              <div class="xp-head">
                <h3>
                  {entry.data.company} <span class="role">— {entry.data.role}</span>
                </h3>
                <span class="dates">{formatRange(entry.data.start, entry.data.end)}</span>
              </div>
              {entry.data.location && <p class="xp-sub">{entry.data.location}</p>}
              <ul class="highlights">
                {entry.data.highlights.map((h) => (
                  <li>
                    <span>{h.text}</span>
                    {h.metric && <span class="chip">{h.metric}</span>}
                  </li>
                ))}
              </ul>
              {entry.data.stack.length > 0 && (
                <div class="tags">
                  {entry.data.stack.map((s) => (
                    <span>{s}</span>
                  ))}
                </div>
              )}
            </article>
          ))
        }
      </div>
    </section>

    <section class="section" id="skills">
      <div class="wrap">
        <div class="section-head">
          <span class="num kicker">03</span>
          <h2>Capabilities</h2>
          <span class="rule" aria-hidden="true"></span>
        </div>
        <div class="skills-grid">
          {
            SITE.skills.map((group) => (
              <div>
                <h3>{group.group}</h3>
                <ul>
                  {group.items.map((item) => (
                    <li>{item}</li>
                  ))}
                </ul>
              </div>
            ))
          }
        </div>
      </div>
    </section>

    <section class="section" id="contact">
      <div class="wrap">
        <div class="section-head">
          <span class="num kicker">04</span>
          <h2>Contact</h2>
          <span class="rule" aria-hidden="true"></span>
        </div>
        <div class="contact-grid">
          <div>
            <p class="contact-lead">
              Have something worth building? I read every message.
            </p>
            <a class="contact-email" href={`mailto:${SITE.email}`}>{SITE.email}</a>
            <div class="contact-socials">
              {
                SITE.socials.map((s) => (
                  <a href={s.url} target="_blank" rel="noopener noreferrer">
                    <span class="kicker">{s.label}</span>
                    <span>{s.handle}</span>
                  </a>
                ))
              }
            </div>
          </div>
          <form class="contact-form" data-contact action="/api/contact" method="POST" novalidate>
            <div class="field">
              <label for="cf-name">Name</label>
              <input id="cf-name" name="name" type="text" required maxlength="120" autocomplete="name" />
            </div>
            <div class="field">
              <label for="cf-email">Email</label>
              <input id="cf-email" name="email" type="email" required maxlength="200" autocomplete="email" />
            </div>
            <div class="field hp" aria-hidden="true">
              <label for="cf-website">Website</label>
              <input id="cf-website" name="website" type="text" tabindex="-1" autocomplete="off" />
            </div>
            <div class="field">
              <label for="cf-message">Message</label>
              <textarea id="cf-message" name="message" required maxlength="5000"></textarea>
            </div>
            <button class="btn" type="submit">Send message</button>
            <p class="form-status" role="status"></p>
          </form>
        </div>
      </div>
    </section>
  </main>

  <script>
    import '../scripts/contact-form';
  </script>
</Base>
