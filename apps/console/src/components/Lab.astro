---
import SectionHead from './SectionHead.astro';
import { getCollection } from 'astro:content';

const items = (await getCollection('lab')).sort((a, b) => a.data.order - b.data.order);

/* Tiny inline glyph set for the thumbnails — one animated SVG per card. */
const glyphs: Record<string, string> = {
  spin: `<g class="glyph-spin" stroke="currentColor" fill="none" stroke-width="1.5">
           <rect x="10" y="10" width="24" height="24" rx="5"></rect>
           <circle cx="22" cy="22" r="7"></circle></g>`,
  pulse: `<g class="glyph-pulse" stroke="currentColor" fill="none" stroke-width="1.5">
            <circle cx="22" cy="22" r="6"></circle>
            <circle cx="22" cy="22" r="12" opacity=".5"></circle></g>`,
  scan: `<g class="glyph-scan" stroke="currentColor" fill="none" stroke-width="1.5">
           <rect x="9" y="13" width="26" height="18" rx="4"></rect>
           <path d="M13 22h18" stroke-linecap="round"></path></g>`,
  draw: `<path class="glyph-draw" d="M8 30c6-14 10-16 14-10s8 4 14-8" stroke="currentColor"
           fill="none" stroke-width="1.5" stroke-linecap="round"></path>`,
  blink: `<g class="glyph-blink" stroke="currentColor" fill="none" stroke-width="1.5">
            <path d="M12 14v16l16-8Z" stroke-linejoin="round"></path></g>`,
};
---

<section class="section" id="lab">
  <div class="container">
    <SectionHead
      eyebrow="Lab"
      title="Experiments & small tools"
      lede="Prototype beats polished-but-imaginary. These are small things built to learn, break and measure."
    />

    <div class="lab-tools" data-reveal>
      <input class="lab-search" type="search" placeholder="grep the lab…" aria-label="Filter experiments" />
      <span class="lab-count tnum">{items.length} / {items.length}</span>
    </div>

    <div class="lab-grid" data-reveal data-reveal-delay="1">
      {
        items.map((item) => {
          const d = item.data;
          const inner = (
            <>
              <span class="lab-glyph" aria-hidden="true">
                <svg viewBox="0 0 44 44" set:html={glyphs[d.glyph] ?? glyphs.pulse} />
              </span>
              <span>
                <span class="lab-name">{d.name}</span>
                <p class="lab-note">{d.note}</p>
              </span>
              <span class="lab-arrow" aria-hidden="true">→</span>
            </>
          );

          return d.link ? (
            <a class="lab-item" href={d.link} target="_blank" rel="noopener">
              {inner}
            </a>
          ) : (
            <div class="lab-item">{inner}</div>
          );
        })
      }
    </div>

    <div class="lab-empty" hidden>Nothing matches — try another query.</div>
  </div>
</section>

<script>
  import '../scripts/lab-search';
</script>
