---
import { SITE } from '../config/site';

const links = [
  { href: '#work', label: 'Work' },
  { href: '#lab', label: 'Lab' },
  { href: '#experience', label: 'Experience' },
  { href: '#about', label: 'About' },
  { href: '#contact', label: 'Contact' },
];
---

<header class="nav">
  <div class="container nav-inner">
    <a class="nav-brand" href="#top" aria-label={`${SITE.name} — home`}>
      <span class="nav-brand-mark" aria-hidden="true">{SITE.initials}</span>
      <span>{SITE.name}</span>
    </a>

    <nav class="nav-links" aria-label="Sections">
      {links.map((l) => <a class="nav-link" href={l.href}>{l.label}</a>)}
    </nav>

    <div class="nav-actions">
      {
        SITE.features.commandPalette && (
          <button class="nav-cmd" type="button" data-cmdk-open aria-label="Open command palette">
            <span aria-hidden="true">Search</span>
            <kbd class="kbd">⌘K</kbd>
          </button>
        )
      }
      <a class="btn btn--primary btn--sm nav-cta magnetic" href="#contact">Get in touch</a>
      <button
        class="icon-btn nav-toggle"
        type="button"
        aria-expanded="false"
        aria-label="Open menu"
      >
        <svg width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true">
          <path d="M2 4h12M2 8h12M2 12h12" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"
            > </path>
        </svg>
      </button>
    </div>
  </div>
  <div class="nav-progress" aria-hidden="true"></div>
</header>

<div class="mobile-menu" id="mobile-menu">
  <nav aria-label="Sections (mobile)">
    {links.map((l) => <a href={l.href}>{l.label}</a>)}
  </nav>
  <div class="mobile-menu-foot">
    <a href={`mailto:${SITE.email}`}>{SITE.email}</a>
    {
      SITE.socials.map((s) => (
        <a href={s.url} target="_blank" rel="noopener">
          {s.label}
        </a>
      ))
    }
  </div>
</div>

<script>
  import '../scripts/chrome';
</script>
