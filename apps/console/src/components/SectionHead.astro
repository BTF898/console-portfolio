---
interface Props {
  eyebrow: string;
  title: string;
  lede?: string;
}

const { eyebrow, title, lede } = Astro.props;
---

<div class="section-head" data-reveal>
  <p class="section-eyebrow">{eyebrow}</p>
  <h2 class="section-title">{title}</h2>
  {lede && <p class="section-lede">{lede}</p>}
</div>
