---
import Base from '../layouts/Base.astro';
---

<Base title="404 — Page not found">
  <main class="notfound">
    <div class="wrap">
      <p class="kicker">Error 404</p>
      <h1><em>Blank page.</em></h1>
      <p>The address you followed doesn't exist — but the rest of the site does.</p>
      <a class="btn" href="/">Back home</a>
    </div>
  </main>
</Base>
