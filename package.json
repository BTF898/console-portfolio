{
  "name": "portfolio-monorepo",
  "version": "1.1.0",
  "description": "Monorepo root — orchestration only. The sites live in apps/ (console: dark terminal UI, atelier: editorial UI + backend), shared packages in packages/. Each app builds and deploys independently.",
  "type": "module",
  "private": true,
  "engines": {
    "node": ">=20"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "concurrently -n console,atelier -c blue,green \"npm:dev:console\" \"npm:dev:atelier\"",
    "build": "npm run build:console && npm run build:atelier",
    "dev:console": "npm run dev --workspace @console/site",
    "build:console": "npm run build --workspace @console/site",
    "preview:console": "npm run preview --workspace @console/site",
    "dev:atelier": "npm run dev --workspace @atelier/site",
    "build:atelier": "npm run build --workspace @atelier/site",
    "preview:atelier": "npm run preview --workspace @atelier/site"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  },
  "allowScripts": {
    "esbuild": true,
    "sharp": true,
    "better-sqlite3": true
  }
}
